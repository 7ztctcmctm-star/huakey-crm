{
  "version": 2,
  "installCommand": "cd frontend && npm install --include=dev && cd ../backend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily-scoring", "schedule": "0 2 * * *" },
    { "path": "/api/cron/clean-logs", "schedule": "0 3 * * *" },
    { "path": "/api/cron/auto-release", "schedule": "0 1 * * *" },
    { "path": "/api/cron/generate-reminders", "schedule": "30 8 * * *" }
  ]
}
