# ============================================
# Playwright E2E 测试账号配置
# ============================================
# 用途：供 frontend/e2e 下的 Playwright 测试读取，避免在测试代码中硬编码账号密码。
# 加载方式：frontend/playwright.config.js 启动时自动加载本文件到 process.env。
#
# ⚠️ 这些账号由 `npm run seed:demo`（backend/scripts/seed-demo.js）创建，
#    属于 Demo 数据（is_demo=1），仅存在于开发/测试环境。
#    生产环境 seed:demo 会被硬阻断，账号不会存在。
#
# 账号清单（密码统一 Demo@123456）：
#   demo_admin    — 管理员（super_admin，绕过所有权限检查）
#   demo_sales    — 销售（sales）
#   demo_purchase — 采购（purchase）
# ============================================

# 管理员账号（loginAsAdmin / login.spec.js / api-helpers.js 默认使用）
E2E_ADMIN_USER=demo_admin
E2E_ADMIN_PASSWORD=Demo@123456

# 销售账号（按角色测试时使用）
E2E_SALES_USER=demo_sales
E2E_SALES_PASSWORD=Demo@123456

# 采购账号（按角色测试时使用）
E2E_PURCHASE_USER=demo_purchase
E2E_PURCHASE_PASSWORD=Demo@123456

# ============================================
# 兼容变量（向后兼容旧测试代码）
# 若未设置 E2E_ADMIN_*，fixtures 会回退到 E2E_USERNAME / E2E_PASSWORD。
# 这里统一指向 demo_admin，保证旧变量名也能用上 Demo 账号。
# ============================================
E2E_USERNAME=demo_admin
E2E_PASSWORD=Demo@123456
