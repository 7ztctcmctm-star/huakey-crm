@echo off
chcp 65001 >nul

echo ============================================
echo  铧旗CRM 一键部署: 本地 → 测试 → 生产
echo ============================================
echo.

:: 第一步：同步到测试环境
echo [阶段1] 同步代码到测试环境...
echo.
call "%~dp0sync-test.bat"
if errorlevel 1 (
    echo [错误] 测试环境部署失败，已中止
    pause
    exit /b 1
)

:: 第二步：等待用户验证
echo.
echo ============================================
echo  请打开 http://192.168.0.200:6790 验证测试环境
echo ============================================
echo.
echo 验证通过后按任意键推送到生产环境...
echo 按 Ctrl+C 取消
pause >nul

:: 第三步：推送到生产环境
echo.
echo [阶段2] 推送到生产环境...
echo.
call "%~dp0push-prod.bat"
if errorlevel 1 (
    echo [错误] 生产环境部署失败
    pause
    exit /b 1
)

echo.
echo ============================================
echo  全流程部署完成！
echo  测试环境: http://192.168.0.200:6790
echo  生产环境: http://192.168.0.200:6789
echo ============================================
echo.
pause
