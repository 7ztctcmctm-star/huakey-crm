# ============================================
# 铧旗CRM — 群晖NAS 生产环境变量模板
# 使用方法：
#   1. 复制本文件为 .env
#   2. 修改所有密码和 JWT_SECRET
#   3. docker compose -f docker-compose.synology.yml --env-file .env up -d
# ============================================

# ---- MySQL 数据库 ----
# DB_HOST 必须为 docker-compose 中定义的服务名 mysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=crm_user
DB_PASSWORD=your_db_password_here
DB_NAME=huakey_crm

# ---- MySQL Root 密码（Docker 初始化用）----
# 仅首次启动时创建 root 用户，后续修改需手动进入 MySQL 执行
MYSQL_ROOT_PASSWORD=your_strong_password_here

# ---- JWT 认证 ----
# 必须替换为随机生成的 64 字节 hex，执行下面命令生成：
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_generated_64_byte_hex_string
JWT_EXPIRES_IN=7d

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# ---- 跨域配置 ----
# 生产环境填写 NAS 的实际访问地址（必须与浏览器地址栏完全一致）。
# 当前为 HTTPS 内网域名方案：DSM nginx 443 → 容器 nginx 8443 → app:5000
# 若直接访问容器 8443：https://<NAS_IP>:8443
# 示例：https://crm.huakey.local
CORS_ORIGIN=https://crm.huakey.local

# ---- AI 模型（Ollama 本地）----
# 在 NAS 上运行 Ollama 时，host.docker.internal 指向 NAS 宿主机
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# ---- 公海自动回收天数 ----
AUTO_RELEASE_DAYS=30

# ---- 邮箱加密密钥（可选，用于集成邮箱凭证加密）----
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENC_KEY=

# ---- Swagger API 文档 ----
# 生产环境建议关闭
ENABLE_SWAGGER=false

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 企业微信告警 ----
ALERT_ENABLED=false
WECHAT_WEBHOOK_URL=

# ---- 日志级别 ----
LOG_LEVEL=info
