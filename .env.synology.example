# ============================================
# 铧旗CRM — 群晖NAS 生产环境变量模板
# 使用方法：
#   1. 复制本文件为 .env
#   2. 修改所有密码和 JWT_SECRET
#   3. docker compose -f docker-compose.synology.yml --env-file .env up -d
# ============================================

# ---- MySQL 数据库 ----
# DB_HOST 必须是 docker-compose 中定义的服务名 mysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=huakey_crm

# ---- MySQL Root 密码（Docker 初始化用）----
# 仅首次启动时创建 root 用户，后续修改需手动进入 MySQL 执行
MYSQL_ROOT_PASSWORD=root123

# ---- JWT 认证 ----
# 必须替换为随机生成的 64 字节 hex，执行下面命令生成：
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_generated_64_byte_hex_string
JWT_EXPIRES_IN=7d

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# ---- 跨域配置 ----
# 生产环境填写 NAS 的访问地址，如 http://192.168.0.200 或 https://crm.example.com
CORS_ORIGIN=http://192.168.0.200

# ---- AI 模型（Ollama 本地）----
# 在 NAS 上运行 Ollama 时，host.docker.internal 指向 NAS 宿主机
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# ---- 公海自动回收天数 ----
AUTO_RELEASE_DAYS=30

# ---- Swagger API 文档 ----
# 生产环境建议关闭
ENABLE_SWAGGER=false
