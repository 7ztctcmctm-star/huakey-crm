# ============================================
# 铧旗CRM系统 — 环境变量配置模板
# 复制此文件为 .env 并修改实际值
# ============================================

# ---- 服务端口 ----
PORT=5000

# ---- MySQL 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=crm_user
DB_PASSWORD=your_secure_password_here
DB_NAME=huakey_crm

# ---- JWT 认证 ----
# 重要：生产环境必须更换为随机生成的强密钥
# 生成方式: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_random_64_byte_hex_string
JWT_EXPIRES_IN=7d

# ---- Redis （可选，当前默认关闭）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
