# ============================================
# 铧旗CRM — 生产环境敏感凭据注入模板
# ⚠️ 安全提醒：本文件仅作为模板，请勿直接提交真实值到 git。
#
# 使用方法：
#   1. 复制本文件为 .env.secrets
#   2. 填写生产环境的真实敏感值
#   3. 确保 .env.secrets 已加入 .gitignore
#   4. 部署前执行：bash deploy/inject-secrets.sh
# ============================================

# ---- MySQL 数据库（应用账号）----
# 必须与 docker-compose.synology.yml 中 mysql 服务创建的用户密码一致
DB_PASSWORD=your_production_db_password_here

# ---- MySQL Root 密码（Docker 初始化用）----
MYSQL_ROOT_PASSWORD=your_production_root_password_here

# ---- 测试栈专用数据库凭据（deploy/docker-compose.test.yml）----
# [P2-14] 必须与上面的生产凭据不同；缺失任一项测试 compose 会 fail-fast 拒绝启动。
# 禁止把生产口令填到这里。
MYSQL_ROOT_PASSWORD_TEST=your_test_root_password_here
DB_PASSWORD_TEST=your_test_db_password_here

# ---- JWT 认证 ----
# 必须替换为随机生成的 64 字节 hex，执行下面命令生成：
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_generated_64_byte_hex_string

# 测试环境专用 JWT 密钥（必须与上面的 JWT_SECRET【不同】）
# 【P0-2】deploy/docker-compose.test.yml 使用本变量。
# 若与生产共用同一密钥，测试环境签发的 token 在生产环境同样有效，环境隔离将失效。
# 生成方式同上，请另行随机生成一份：
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_TEST=your_different_64_byte_hex_string_for_test_env

# ---- Redis 密码（如启用）----
# 若 Redis 未设置密码，可留空
REDIS_PASSWORD=

# ---- 初始管理员密码 ----
# 部署时会用该密码生成 bcrypt hash 并创建 admin 账号
# 必须替换为高强度密码，首次登录后系统会强制改密
ADMIN_INITIAL_PASSWORD=your_strong_admin_password_here

# ---- 跨域配置（生产环境必须设置）----
# 生产访问地址（内网域名 + HTTPS），禁止 localhost/127.0.0.1/*
CORS_ORIGIN=https://crm.huakey.local

# 测试环境访问地址（deploy/docker-compose.test.yml 必填）
CORS_ORIGIN_TEST=http://192.168.0.200:6790

# ---- 企业微信通知（可选）----
# 留空表示不启用企业微信告警；若启用则填写真实 Webhook URL
WECHAT_WEBHOOK_URL=

# ---- 邮箱加密密钥（32字节hex）----
# 用于加密存储邮箱 SMTP 授权码
EMAIL_ENC_KEY=

# ---- 企业微信告警开关 ----
# [P2-11] 默认开启；启用前提是配置 WECHAT_WEBHOOK_URL 或 SMTP_* + ALERT_EMAIL_TO。
# 未配置通道时应用启动会打印告警，但不会静默丢弃错误。
ALERT_ENABLED=true
