# ============================================
# Playwright E2E 测试账号配置 — 模板
# ============================================
# 使用方法：复制为 .env.test 并按需修改
#   cp .env.test.example .env.test
#
# 加载方式：frontend/playwright.config.js 启动时自动加载 .env.test 到 process.env。
#
# 账号由 `npm run seed:demo` 创建（Demo 数据，is_demo=1），
# 仅存在于开发/测试环境，生产环境不会创建。
# 详见 docs/DEMO_DATA_GUIDE.md
# ============================================

# 管理员账号（loginAsAdmin / login.spec.js / api-helpers.js 默认使用）
E2E_ADMIN_USER=demo_admin
E2E_ADMIN_PASSWORD=Demo@123456

# 销售账号
E2E_SALES_USER=demo_sales
E2E_SALES_PASSWORD=Demo@123456

# 采购账号
E2E_PURCHASE_USER=demo_purchase
E2E_PURCHASE_PASSWORD=Demo@123456

# 兼容变量（旧测试代码回退使用）
E2E_USERNAME=demo_admin
E2E_PASSWORD=Demo@123456
