# ============================================
# 铧旗CRM系统 — 环境变量配置模板
# 复制此文件为 .env 并修改实际值
# 生产环境部署前必须执行：node deploy/validate-env.js
# ============================================

# ---- 服务端口 ----
PORT=5000

# ---- MySQL 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=crm_user
# 生产环境必须替换为随机强密码（≥16位，含大小写+数字+符号）
DB_PASSWORD=your_secure_password_here
DB_NAME=huakey_crm

# ---- MySQL 只读账号（AI查询专用，强烈建议配置）----
# 创建只读账号SQL: CREATE USER 'crm_ro'@'%' IDENTIFIED BY 'xxx'; GRANT SELECT ON huakey_crm.* TO 'crm_ro'@'%';
# DB_RO_HOST=localhost
# DB_RO_PORT=3306
# DB_RO_USER=crm_ro
# DB_RO_PASSWORD=your_readonly_password_here
# DB_RO_NAME=huakey_crm

# ---- JWT 认证 ----
# 重要：生产环境必须更换为随机生成的强密钥
# 生成方式: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 安全校验：长度必须为 128 个十六进制字符（64 字节）
JWT_SECRET=your_generated_64_byte_hex_string
JWT_EXPIRES_IN=7d

# ---- Redis （可选，当前默认关闭）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- AI 模型（Ollama 本地）----
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# MiMo 云端模型（暂未实现，后续版本支持）

# ---- 跨域配置（生产环境必须设置）----
# 设置为生产访问地址，如 https://crm.example.com
# 注意：当前仅支持单一域名，暂不支持多域名逗号分隔
# 生产环境禁止设置为 localhost/127.0.0.1
CORS_ORIGIN=http://localhost:5173

# ---- 运行环境 ----
# development: 开发模式（启用 CORS *、Swagger、详细日志）
# production:  生产模式（精确 CORS、HSTS、精简日志）
NODE_ENV=development

# ---- Redis 缓存开关 ----
# true:  启用 Redis 缓存（需要 REDIS_HOST 可达）
# false: 跳过所有缓存，直接查询 MySQL
REDIS_ENABLED=false

# ---- 公海自动回收天数 ----
# 潜客超过此天数未跟进自动掉入公海，默认 30
AUTO_RELEASE_DAYS=30

# ---- MySQL Root 密码（仅 docker-compose 使用，应用不读取）----
# 注意：此变量与上面的 DB_PASSWORD 不同，DB_PASSWORD 是应用账号 crm_user 的密码
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# ---- Swagger API 文档 ----
# true:  启用 /api-docs 文档页面
# false: 生产环境建议关闭
ENABLE_SWAGGER=false

# ---- 企业微信通知 ----
# 替换为你的企业微信机器人 Webhook URL
WECHAT_WEBHOOK_URL=

# ---- 日志级别 ----
LOG_LEVEL=info

# ---- 邮箱加密密钥（用于加密存储邮箱授权码）----
# 32 字节 hex，生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENC_KEY=

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 企业微信告警开关 ----
# true: 启用企业微信+邮件告警（需要 WECHAT_WEBHOOK_URL）
ALERT_ENABLED=false

# ---- 信任代理（nginx 反代后需设为 1）----
# TRUST_PROXY=1

# ---- 开发调试用：跳过验证码 ----
# ⚠️ 生产环境必须设置为 false
SKIP_CAPTCHA=false
