{
  "version": 2,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/cron/daily-scoring", "schedule": "0 2 * * *" },
    { "path": "/cron/clean-logs", "schedule": "0 3 * * *" },
    { "path": "/cron/auto-release", "schedule": "0 1 * * *" },
    { "path": "/cron/generate-reminders", "schedule": "30 8 * * *" }
  ]
}
